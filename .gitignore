# Only immutable, explicitly allowlisted payloads are versioned from .venv.
/.venv/*
!/.venv/portable-runtime/
!/.venv/portable-git/
/.venv/portable-runtime/*
!/.venv/portable-runtime/manifest.json
!/.venv/portable-runtime/requirements-lock.json
!/.venv/portable-runtime/LICENSES.json
!/.venv/portable-runtime/README.md
!/.venv/portable-runtime/runtime.zip.part[0-9][0-9][0-9]
/.venv/portable-git/*
!/.venv/portable-git/manifest.json
!/.venv/portable-git/git.zip
**/__pycache__/
*.py[cod]
/.agents/
/localdata/
/.pytest_cache/
/.update_*/
/.webagent_*
*.bak
*.smartagent_pre_snapshot_fix
/config/debug_config.json
/source/run_t16_*.py
/SmartAgentv2_1/
/.env*
/.aws/
/.ssh/

**/dom_config.history/
**/dom_config - *.json
*.identity.bak
*.positional-args.bak
*.progress-*.bak

**/.agents/
**/localdata/
*.tmp
!/.venv/
/defaultworkspace/

!/.venv/.gitignore

# Local mappings override tracked sanitized defaults.
**/dom_config.json
/config/browser_session.json
*.log
**/WebAgent/state/
/install_smart_agent/environment_report.txt
/install_smart_agent/install_report.txt
/install_smart_agent/install-state.json
/doc/portable_git_handoff.md
